@using API.Clients
@inject IAuthService AuthService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@homeRoute">Veterinaria</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@homeRoute" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        @if (isDuenio)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="duenio/mascotas">
                    <span class="oi oi-heart" aria-hidden="true"></span> Mis Mascotas
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="duenio/turnos">
                    <span class="oi oi-calendar" aria-hidden="true"></span> Sacar Turnos
                </NavLink>
            </div>
        }
        else
        {
            @if (canReadVeterinarios)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="veterinarios">
                        <span class="oi oi-people" aria-hidden="true"></span> Veterinarios
                    </NavLink>
                </div>
            }

            @if (canReadEstudios)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="estudios">
                        <span class="oi oi-document" aria-hidden="true"></span> Estudios
                    </NavLink>
                </div>
            }

            @if (canReadTurnos)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="turnos">
                        <span class="oi oi-calendar" aria-hidden="true"></span> Turnos
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private bool canReadVeterinarios = false;
    private bool canReadEstudios = false;
    private bool canReadTurnos = false;

    private bool isDuenio = false;

    private string homeRoute = "";

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await CheckPermissions();
        await base.OnInitializedAsync();
    }

    private async Task CheckPermissions()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            var rol = await AuthService.GetRolAsync();
            var rolNormalizado = rol?.Trim().ToUpper();

            isDuenio = (rolNormalizado == "DUEÑO" || rolNormalizado == "DUENIO" || rolNormalizado == "DUENO");

            if (isDuenio)
            {
                canReadVeterinarios = false;
                canReadEstudios = false;
                canReadTurnos = false;
                homeRoute = "duenio";
            }
            else
            {
                canReadVeterinarios = await AuthService.HasPermissionAsync("veterinarios.leer");
                canReadEstudios = await AuthService.HasPermissionAsync("estudios.leer");
                canReadTurnos = await AuthService.HasPermissionAsync("turnos.leer");

                if (rolNormalizado == "ADMINISTRADOR")
                {
                    homeRoute = "admin";
                }
                else if (rolNormalizado == "VETERINARIO")
                {
                    homeRoute = "vet";
                }
            }
        }
        else
        {
            isDuenio = false;
            canReadVeterinarios = false;
            canReadEstudios = false;
            canReadTurnos = false;
            homeRoute = "";
        }
        StateHasChanged();
    }

    private void OnAuthenticationStateChanged(bool authenticated)
    {
        InvokeAsync(async () =>
        {
            await CheckPermissions();
        });
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}