@inherits LayoutComponentBase
@using API.Clients
@using API.Auth.Blazor.Server
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Blazor.Server</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end">
            <AuthorizeView>
                <Authorized>
                    <button class="btn btn-primary btn-sm" @onclick="Logout">Cerrar Sesión</button>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-outline-primary btn-sm">Iniciar Sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        var customAuthStateProvider = (BlazorServerAuthService)AuthStateProvider;
        customAuthStateProvider.NotificarLogout();
        Navigation.NavigateTo("/login");
    }
}