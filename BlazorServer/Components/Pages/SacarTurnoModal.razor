@using DTOs
@using API.Clients
@inject MascotaClient MascotaClient
@inject TurnoClient TurnoClient
@inject IAuthService AuthService

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-calendar-check me-2"></i>Confirmar Turno</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info mb-4">
                        Está a punto de reservar este turno. Por favor, seleccione para qué mascota es la consulta.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Seleccionar Mascota *</label>
                        <select class="form-select" @bind="idMascotaSeleccionada">
                            <option value="0">-- Elija una mascota --</option>
                            @if (misMascotas != null)
                            {
                                foreach (var mascota in misMascotas)
                                {
                                    <option value="@mascota.IdMascota">@mascota.NombreMascota (@mascota.Especie)</option>
                                }
                            }
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2 small">@errorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cerrar" disabled="@saving">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmarTurno" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Confirmar Reserva
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnTurnoGuardado { get; set; }

    private bool showModal = false;
    private TurnoDTO? turnoActual;
    private List<MascotaDTO>? misMascotas;
    private int idMascotaSeleccionada = 0;

    private bool saving = false;
    private string errorMessage = string.Empty;

    public async Task ShowModal(TurnoDTO turno)
    {
        turnoActual = turno;
        idMascotaSeleccionada = 0;
        errorMessage = string.Empty;
        showModal = true;

        var personaId = await AuthService.GetPersonaIdAsync();
        if (personaId.HasValue)
        {
            misMascotas = await MascotaClient.GetAllByDuenioAsync(personaId.Value);
        }

        StateHasChanged();
    }

    private async Task ConfirmarTurno()
    {
        if (idMascotaSeleccionada == 0)
        {
            errorMessage = "Debe seleccionar una mascota para reservar el turno.";
            return;
        }

        if (turnoActual == null)
        {
            errorMessage = "No se ha seleccionado ningún turno válido.";
            return;
        }

        try
        {
            saving = true;
            errorMessage = string.Empty;

            turnoActual.IdMascota = idMascotaSeleccionada;
            turnoActual.EstadoTurno = "Otorgado";

            await TurnoClient.UpdateAsync(turnoActual);

            await OnTurnoGuardado.InvokeAsync();
            Cerrar();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al procesar la reserva: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void Cerrar()
    {
        showModal = false;
        StateHasChanged();
    }
}