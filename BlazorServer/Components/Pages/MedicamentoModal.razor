@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject MedicamentoClient MedicamentoClient

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (mode == FormMode.Add)
                        {
                            <text>Agregar</text>
                        }
                        else
                        {
                            <text>Editar</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentMedicamento" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        @if (mode == FormMode.Update)
                        {
                            <div class="mb-3">
                                <label class="form-label">Id</label>
                                <input type="text" class="form-control" value="@currentMedicamento.IdMedicamento" readonly />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Nombre *</label>
                            <InputText @bind-Value="currentMedicamento.NombreMedicamento" class="form-control" />
                            @if (validationErrors.ContainsKey("NombreMedicamento"))
                            {
                                <div class="text-danger small">@validationErrors["NombreMedicamento"]</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantidad Restante *</label>
                            <InputNumber @bind-Value="currentMedicamento.CantidadRestante" class="form-control" />
                            @if (validationErrors.ContainsKey("CantidadRestante"))
                            {
                                <div class="text-danger small">@validationErrors["CantidadRestante"]</div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">
                                @errorMessage
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@saving">
                                @if (saving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @(mode == FormMode.Add ? "Agregar" : "Actualizar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnMedicamentoChanged { get; set; }

    private bool showModal = false;
    private FormMode mode = FormMode.Add;
    private MedicamentoDTO currentMedicamento = new MedicamentoDTO();
    private bool saving = false;
    private string errorMessage = string.Empty;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    public enum FormMode
    {
        Add,
        Update
    }

    public void ShowAddModal()
    {
        mode = FormMode.Add;
        currentMedicamento = new MedicamentoDTO
        {
            NombreMedicamento = string.Empty,
            CantidadRestante = 0
        };
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    public void ShowEditModal(MedicamentoDTO medicamento)
    {
        mode = FormMode.Update;
        currentMedicamento = new MedicamentoDTO
        {
            IdMedicamento = medicamento.IdMedicamento,
            NombreMedicamento = medicamento.NombreMedicamento,
            CantidadRestante = medicamento.CantidadRestante
        };
        ClearValidationErrors();
        showModal = true;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (!ValidateMedicamento())
            return;

        try
        {
            saving = true;
            errorMessage = string.Empty;

            if (mode == FormMode.Add)
            {
                await MedicamentoClient.AddAsync(currentMedicamento);
            }
            else
            {
                await MedicamentoClient.UpdateAsync(currentMedicamento);
            }

            await OnMedicamentoChanged.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private bool ValidateMedicamento()
    {
        ClearValidationErrors();
        bool isValid = true;

        if (string.IsNullOrWhiteSpace(currentMedicamento.NombreMedicamento))
        {
            validationErrors["NombreMedicamento"] = "El Nombre es requerido";
            isValid = false;
        }

        if (currentMedicamento.CantidadRestante < 0)
        {
            validationErrors["CantidadRestante"] = "La cantidad no puede ser negativa";
            isValid = false;
        }

        StateHasChanged();
        return isValid;
    }

    private void ClearValidationErrors()
    {
        validationErrors.Clear();
        errorMessage = string.Empty;
    }

    private void Close()
    {
        showModal = false;
        ClearValidationErrors();
        StateHasChanged();
    }
}