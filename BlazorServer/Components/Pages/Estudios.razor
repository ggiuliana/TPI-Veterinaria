@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject EstudioClient EstudioClient

<h4>Gestión de Estudios</h4>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Estudios</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Descripcion</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (estudios != null && estudios.Any())
                            {
                                @foreach (var est in estudios)
                                {
                                    <tr>
                                        <td>@est.IdEstudio</td>
                                        <td>@est.NombreEstudio</td>
                                        <td>@est.DescripcionEstudio</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(est)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(est)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<EstudioModal @ref="estudioModal" OnEstudioChanged="LoadEstudios" />

@code {
    private List<EstudioDTO>? estudios;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private EstudioModal estudioModal = default!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    private bool isEditing = false;
    private bool saving = false;
    private EstudioModal.FormMode mode;
    private EstudioDTO currentEstudio = new();

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPermissions();

        if (canRead)
        {
            await LoadEstudios();
        }
        else
        {
            errorMessage = "No tiene permisos para ver estudios.";
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadPermissions();

            if (canRead)
            {
                await LoadEstudios();
            }
            else
            {
                errorMessage = "No tiene permisos para ver estudios.";
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("estudios.leer");
        canAdd = await AuthService.HasPermissionAsync("estudios.agregar");
        canUpdate = await AuthService.HasPermissionAsync("estudios.actualizar");
        canDelete = await AuthService.HasPermissionAsync("estudios.eliminar");
    }

    private async Task LoadEstudios()
    {
        try
        {
            loading = true;
            estudios = (await EstudioClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar estudios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (estudioModal != null)
        {
            await estudioModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(EstudioDTO est)
    {
        if (estudioModal != null)
        {
            await estudioModal.ShowEditModal(est);
        }
    }

    private async Task Eliminar(EstudioDTO est)
    {
        await EstudioClient.DeleteAsync(est.IdEstudio);
        await LoadEstudios();
    }

    private void Cancel()
    {
        isEditing = false;
    }

    private async Task ConfirmDelete(EstudioDTO est)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el estudio {est.NombreEstudio}?");

        if (confirm)
        {
            await DeleteEstudio(est.IdEstudio);
        }
    }

    private async Task DeleteEstudio(int id)
    {
        try
        {
            await EstudioClient.DeleteAsync(id);
            successMessage = "Estudio eliminado exitosamente.";
            await LoadEstudios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar estudio: {ex.Message}";
        }
    }
}