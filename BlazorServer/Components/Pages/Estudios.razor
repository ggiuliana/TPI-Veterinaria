@page "/estudios"

@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject EstudioClient EstudioClient

<PageTitle>Gestión de Estudios</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Estudios</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (canRead)
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (estudios != null && estudios.Any())
                            {
                                @foreach (var est in estudios)
                                {
                                    <tr>
                                        <td class="align-middle">@est.IdEstudio</td>
                                        <td class="align-middle">@est.NombreEstudio</td>
                                        <td class="align-middle">@est.DescripcionEstudio</td>
                                        <td class="align-middle text-nowrap">
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(est)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(est)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No hay estudios registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<EstudioModal @ref="estudioModal" OnEstudioChanged="LoadEstudios" />

@code {
    private List<EstudioDTO>? estudios;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private EstudioModal estudioModal = default!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var rol = await AuthService.GetRolAsync();
        if (rol?.Trim().ToUpper() != "ADMINISTRADOR")
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadPermissions();

        if (canRead)
        {
            await LoadEstudios();
        }
        else
        {
            loading = false;
            errorMessage = "No tiene permisos para ver estudios.";
        }
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("estudios.leer");
        canAdd = await AuthService.HasPermissionAsync("estudios.agregar");
        canUpdate = await AuthService.HasPermissionAsync("estudios.actualizar");
        canDelete = await AuthService.HasPermissionAsync("estudios.eliminar");
    }

    private async Task LoadEstudios()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;
            estudios = (await EstudioClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar estudios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (estudioModal != null)
        {
            await estudioModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(EstudioDTO est)
    {
        if (estudioModal != null)
        {
            await estudioModal.ShowEditModal(est);
        }
    }

    private async Task ConfirmDelete(EstudioDTO est)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el estudio {est.NombreEstudio}?");

        if (confirm)
        {
            await DeleteEstudio(est.IdEstudio);
        }
    }

    private async Task DeleteEstudio(int id)
    {
        try
        {
            await EstudioClient.DeleteAsync(id);
            successMessage = "Estudio eliminado exitosamente.";
            await LoadEstudios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar estudio: {ex.Message}";
        }
    }
}