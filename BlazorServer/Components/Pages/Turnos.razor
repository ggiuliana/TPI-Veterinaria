@page "/turnos"
@rendermode InteractiveServer

@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject TurnoClient TurnoClient

<PageTitle>Gestión de Turnos y Consultas</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Turnos y Consultas</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3 d-flex gap-2">
                    @if (canAdd)
                    {
                        <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                            <i class="fas fa-plus"></i> Nuevo Turno
                        </button>
                    }

                    <button type="button" class="btn btn-outline-info" @onclick="@(() => Navigation.NavigateTo("/metricas"))">
                        <i class="fas fa-chart-pie"></i> Ver Métricas
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (canRead)
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Estado</th>
                                <th>Observaciones / Consulta</th>
                                <th>ID Vet</th>
                                <th>ID Mascota</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (turnos != null && turnos.Any())
                            {
                                @foreach (var turno in turnos)
                                {
                                    <tr>
                                        <td class="align-middle">@turno.IdTurno</td>
                                        <td class="align-middle">@turno.FechaTurno.ToString("dd/MM/yyyy")</td>
                                        <td class="align-middle">@turno.HoraTurno.ToString("HH:mm")</td>
                                        <td class="align-middle">
                                            <span class="badge @GetBadgeClass(turno.EstadoTurno)">
                                                @turno.EstadoTurno
                                            </span>
                                        </td>
                                        <td class="align-middle text-truncate" style="max-width: 200px;" title="@turno.Observaciones">
                                            @(string.IsNullOrWhiteSpace(turno.Observaciones) ? "-" : turno.Observaciones)
                                        </td>
                                        <td class="align-middle">@turno.IdVeterinario</td>
                                        <td class="align-middle">@(turno.IdMascota?.ToString() ?? "-")</td>
                                        <td class="align-middle text-nowrap">
                                            @if (turno.EstadoTurno?.ToLower() == "otorgado" || turno.EstadoTurno?.ToLower() == "resuelto")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-info me-1" @onclick="() => VerConsulta(turno.IdTurno)">
                                                    <i class="fas fa-notes-medical"></i> Ver Consulta
                                                </button>
                                            }

                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(turno)">
                                                    <i class="fas fa-edit"></i> Gestionar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(turno)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No hay turnos registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<TurnoModal @ref="turnoModal" OnTurnoChanged="LoadTurnos" />
<ConsultaModal @ref="consultaModal" OnConsultaGuardada="LoadTurnos" />

@code {
    private List<TurnoDTO>? turnos;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private TurnoModal turnoModal = default!;
    private ConsultaModal consultaModal = default!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    private string rolUsuario = string.Empty;
    private int? idPersona = 0;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var rol = await AuthService.GetRolAsync();
        rolUsuario = rol?.Trim().ToUpper() ?? string.Empty;

        if (rolUsuario != "ADMINISTRADOR" && rolUsuario != "VETERINARIO")
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (rolUsuario == "VETERINARIO")
        {
            idPersona = await AuthService.GetPersonaIdAsync();
        }

        await LoadPermissions();

        if (canRead)
        {
            await LoadTurnos();
        }
        else
        {
            loading = false;
            errorMessage = "No tiene permisos para ver los turnos.";
        }
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("turnos.leer");
        canAdd = await AuthService.HasPermissionAsync("turnos.agregar");
        canUpdate = await AuthService.HasPermissionAsync("turnos.actualizar");
        canDelete = await AuthService.HasPermissionAsync("turnos.eliminar");
    }

    private async Task LoadTurnos()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            if (rolUsuario == "VETERINARIO")
            {
                if (idPersona.HasValue)
                {
                    turnos = (await TurnoClient.GetByVeterinarioIdAsync(idPersona.Value))?.ToList();
                }
                else
                {
                    errorMessage = "Error: No se pudo identificar el ID del veterinario en la sesión activa.";
                }
            }
            else
            {
                turnos = (await TurnoClient.GetAllAsync())?.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los turnos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (turnoModal != null)
        {
            turnoModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(TurnoDTO turno)
    {
        if (turnoModal != null)
        {
            turnoModal.ShowEditModal(turno);
        }
    }

    private async Task ConfirmDelete(TurnoDTO turno)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea cancelar/eliminar el turno del {turno.FechaTurno:dd/MM/yyyy} a las {turno.HoraTurno:HH:mm}?");

        if (confirm)
        {
            await DeleteTurno(turno.IdTurno);
        }
    }

    private async Task DeleteTurno(int id)
    {
        try
        {
            await TurnoClient.DeleteAsync(id);
            successMessage = "Turno eliminado exitosamente.";
            await LoadTurnos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar el turno: {ex.Message}";
        }
    }

    private async Task VerConsulta(int idTurno)
    {
        if (consultaModal != null)
        {
            await consultaModal.ShowModal(idTurno);
        }
    }

    private string GetBadgeClass(string estado)
    {
        return estado?.ToLower() switch
        {
            "otorgado" => "bg-primary",
            "disponible" => "bg-warning text-dark",
            "resuelto" => "bg-success",
            _ => "bg-secondary"
        };
    }
}