@page "/turnos"

@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject TurnoClient TurnoClient
@inject VeterinarioClient VeterinarioClient

<PageTitle>Gestión de Turnos y Consultas</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Turnos y Consultas</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3 d-flex gap-2">
                    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Nuevo Turno
                    </button>
                    <button type="button" class="btn btn-outline-info" @onclick="@(() => Navigation.NavigateTo("/metricas"))">
                        <i class="fas fa-chart-pie"></i> Ver Métricas
                    </button>
                </div>
            }

            @if (rolUsuario == "ADMINISTRADOR")
            {
                <div class="card mb-4 shadow-sm border-0 bg-light">
                    <div class="card-body">
                        <h6 class="card-title text-secondary mb-3"><i class="fas fa-filter"></i> Filtrar Turnos</h6>
                        <div class="row g-3">
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Estado</label>
                                <select class="form-select" @bind="filtroEstado">
                                    <option value="">Todos</option>
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Otorgado">Otorgado</option>
                                    <option value="Resuelto">Resuelto</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Veterinario</label>
                                <select class="form-select" @bind="filtroIdVeterinario">
                                    <option value="">Todos los veterinarios</option>
                                    @if (veterinariosCombo != null)
                                    {
                                        @foreach (var vet in veterinariosCombo)
                                        {
                                            <option value="@vet.IdVeterinario">@vet.NombreVeterinario @vet.Apellido</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label fw-bold">Fecha Desde</label>
                                <input type="date" class="form-control" @bind="filtroFechaDesde" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Fecha Hasta</label>
                                <input type="date" class="form-control" @bind="filtroFechaHasta" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end gap-2">
                                <button class="btn btn-secondary flex-grow-1" title="Limpiar filtros" @onclick="LimpiarFiltros">
                                    <i class="fas fa-eraser"></i> Limpiar
                                </button>
                                <button class="btn btn-primary flex-grow-1" title="Buscar" @onclick="AplicarFiltros">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (canRead)
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Estado</th>
                                <th>Observaciones / Consulta</th>
                                <th>Veterinario</th>
                                <th>Mascota</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (turnos != null && turnos.Any())
                            {
                                @foreach (var turno in turnos)
                                {
                                    <tr>
                                        <td class="align-middle">@turno.IdTurno</td>
                                        <td class="align-middle">@turno.FechaTurno.ToString("dd/MM/yyyy")</td>
                                        <td class="align-middle">@turno.HoraTurno.ToString("HH:mm")</td>
                                        <td class="align-middle">
                                            <span class="badge @GetBadgeClass(turno.EstadoTurno ?? string.Empty)">
                                                @turno.EstadoTurno
                                            </span>
                                        </td>
                                        <td class="align-middle text-truncate" style="max-width: 200px;" title="@turno.Observaciones">
                                            @(string.IsNullOrWhiteSpace(turno.Observaciones) ? "-" : turno.Observaciones)
                                        </td>

                                        <td class="align-middle">@turno.NombreCompletoVeterinario</td>
                                        <td class="align-middle">@turno.NombreMascota</td>

                                        <td class="align-middle text-nowrap">
                                            @if (turno.EstadoTurno?.ToLower() == "otorgado" || turno.EstadoTurno?.ToLower() == "resuelto")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-info me-1" @onclick="() => VerConsulta(turno.IdTurno)">
                                                    <i class="fas fa-notes-medical"></i> Ver Consulta
                                                </button>
                                            }

                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(turno)">
                                                    <i class="fas fa-edit"></i> Gestionar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(turno)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No hay turnos registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<TurnoModal @ref="turnoModal" OnTurnoChanged="LoadTurnos" />
<ConsultaModal @ref="consultaModal" OnConsultaGuardada="LoadTurnos" />

@code {
    private List<TurnoDTO>? turnos;
    private List<VeterinarioDTO>? veterinariosCombo;

    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private TurnoModal turnoModal = default!;
    private ConsultaModal consultaModal = default!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    private string rolUsuario = string.Empty;
    private int? idPersona = 0;

    private string? filtroEstado;
    private int? filtroIdVeterinario;
    private DateOnly? filtroFechaDesde;
    private DateOnly? filtroFechaHasta;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var rol = await AuthService.GetRolAsync();
        rolUsuario = rol?.Trim().ToUpper() ?? string.Empty;

        if (rolUsuario != "ADMINISTRADOR" && rolUsuario != "VETERINARIO")
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (rolUsuario == "VETERINARIO")
        {
            idPersona = await AuthService.GetPersonaIdAsync();
        }

        await LoadPermissions();

        if (rolUsuario == "ADMINISTRADOR")
        {
            await CargarVeterinariosCombo();
        }

        if (canRead)
        {
            await LoadTurnos();
        }
        else
        {
            loading = false;
            errorMessage = "No tiene permisos para ver los turnos.";
        }
    }

    private async Task CargarVeterinariosCombo()
    {
        try
        {
            veterinariosCombo = (await VeterinarioClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar veterinarios para el filtro: {ex.Message}");
        }
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("turnos.leer");
        canAdd = await AuthService.HasPermissionAsync("turnos.agregar");
        canUpdate = await AuthService.HasPermissionAsync("turnos.actualizar");
        canDelete = await AuthService.HasPermissionAsync("turnos.eliminar");
    }

    private async Task LoadTurnos()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;

            if (rolUsuario == "VETERINARIO")
            {
                if (idPersona.HasValue)
                {
                    turnos = (await TurnoClient.GetByVeterinarioIdAsync(idPersona.Value))?.ToList();
                }
                else
                {
                    errorMessage = "Error: No se pudo identificar el ID del veterinario en la sesión activa.";
                }
            }
            else if (rolUsuario == "ADMINISTRADOR")
            {
                turnos = (await TurnoClient.GetTurnosFiltradosAsync(
                    filtroIdVeterinario,
                    filtroEstado,
                    filtroFechaDesde,
                    filtroFechaHasta))?.ToList();
            }
            else
            {
                turnos = (await TurnoClient.GetAllAsync())?.ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los turnos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AplicarFiltros()
    {
        await LoadTurnos();
    }

    private async Task LimpiarFiltros()
    {
        filtroEstado = null;
        filtroIdVeterinario = null;
        filtroFechaDesde = null;
        filtroFechaHasta = null;

        await LoadTurnos();
    }

    private void OpenAddModal()
    {
        if (turnoModal != null)
        {
            turnoModal.ShowAddModal();
        }
    }

    private void OpenEditModal(TurnoDTO turno)
    {
        if (turnoModal != null)
        {
            turnoModal.ShowEditModal(turno);
        }
    }

    private async Task ConfirmDelete(TurnoDTO turno)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea cancelar/eliminar el turno del {turno.FechaTurno:dd/MM/yyyy} a las {turno.HoraTurno:HH:mm}?");

        if (confirm)
        {
            await DeleteTurno(turno.IdTurno);
        }
    }

    private async Task DeleteTurno(int id)
    {
        try
        {
            await TurnoClient.DeleteAsync(id);
            successMessage = "Turno eliminado exitosamente.";
            await LoadTurnos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar el turno: {ex.Message}";
        }
    }

    private async Task VerConsulta(int idTurno)
    {
        if (consultaModal != null)
        {
            await consultaModal.ShowModal(idTurno);
        }
    }

    private string GetBadgeClass(string estado)
    {
        return estado?.ToLower() switch
        {
            "otorgado" => "bg-primary",
            "pendiente" => "bg-warning text-dark",
            "resuelto" => "bg-success",
            _ => "bg-secondary"
        };
    }
}