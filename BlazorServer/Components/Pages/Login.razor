@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using API.Auth.Blazor.Server
@using API.Clients
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService

<div class="d-flex flex-column gap-4">
    <div>
        <label for="username" class="form-label">Usuario:</label>
        <input id="username" class="form-control" @bind="loginModel.Username" @bind:event="oninput" @onkeyup="HandleKeyUp" />
    </div>

    <div>
        <label for="password" class="form-label">Contraseña:</label>
        <input id="password" type="password" class="form-control" @bind="loginModel.Password" @bind:event="oninput" @onkeyup="HandleKeyUp" />
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger p-2 text-center shadow-sm fw-bold">
            <i class="fas fa-exclamation-circle me-1"></i> @errorMessage
        </div>
    }

    <button type="button" class="btn btn-primary mt-2" disabled="@isLoading" @onclick="HandleLogin">
        @if (isLoading)
        {
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            <span>Ingresando...</span>
        }
        else
        {
            <span>Ingresar</span>
        }
    </button>

    <div class="text-center mt-3">
        <span>¿Eres nuevo? </span>
        <a href="/register" class="text-decoration-none fw-bold">Regístrate aquí</a>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private bool isLoading = false;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ((BlazorServerAuthService)AuthService).InitializeSessionAsync();

            bool isAuth = await AuthService.IsAuthenticatedAsync();

            if (isAuth)
            {
                string? userRole = await AuthService.GetRolAsync();
                RedirigirPorRol(userRole);
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "El usuario y la contraseña son requeridos.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        await Task.Delay(50);

        try
        {
            bool isValidUser = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);

            if (isValidUser)
            {
                string? userRole = await AuthService.GetRolAsync();
                RedirigirPorRol(userRole);
            }
            else
            {
                errorMessage = "Credenciales incorrectas. Verifique su usuario o contraseña.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Credenciales incorrectas. Verifique su usuario o contraseña.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RedirigirPorRol(string? userRole)
    {
        switch (userRole?.Trim().ToUpper())
        {
            case "ADMINISTRADOR":
                NavigationManager.NavigateTo("/admin");
                break;
            case "VETERINARIO":
                NavigationManager.NavigateTo("/vet");
                break;
            case "DUENIO":
                NavigationManager.NavigateTo("/duenio");
                break;
            default:
                NavigationManager.NavigateTo("/");
                break;
        }
    }

    public class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}