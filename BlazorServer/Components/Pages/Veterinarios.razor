@page "/veterinarios"
@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject VeterinarioClient VeterinarioClient
@rendermode InteractiveServer

<h4>Gestión de Veterinarios</h4>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h3>Veterinarios</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Telefono</th>
                                <th>Mail</th>
                                <th>Dni</th>
                                <th>Direccion</th>
                                <th>Matricula</th>
                                <th>Especialidad</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (veterinarios != null && veterinarios.Any())
                            {
                                @foreach (var vet in veterinarios)
                                {
                                    <tr>
                                        <td>@vet.IdVeterinario</td>
                                        <td>@vet.NombreVeterinario</td>
                                        <td>@vet.Apellido</td>
                                        <td>@vet.Telefono</td>
                                        <td>@vet.Mail</td>
                                        <td>@vet.Dni</td>
                                        <td>@vet.Direccion</td>
                                        <td>@vet.Matricula</td>
                                        <td>@vet.Especialidad</td>
                                        <td>
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(vet)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(vet)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<VeterinarioModal @ref="veterinarioModal" OnVeterinarioChanged="LoadVeterinarios" />

@code {
    private List<VeterinarioDTO>? veterinarios;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private VeterinarioModal veterinarioModal = default!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    private bool isEditing = false;
    private bool saving = false;
    private VeterinarioModal.FormMode mode;
    private VeterinarioRegisterDTO currentRegister = new();

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPermissions();

        if (canRead)
        {
            await LoadVeterinarios();
        }
        else
        {
            errorMessage = "No tiene permisos para ver veterinarios.";
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadPermissions();

            if (canRead)
            {
                await LoadVeterinarios();
            }
            else
            {
                errorMessage = "No tiene permisos para ver veterinarios.";
            }

            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("veterinarios.leer");
        canAdd = await AuthService.HasPermissionAsync("veterinarios.agregar");
        canUpdate = await AuthService.HasPermissionAsync("veterinarios.actualizar");
        canDelete = await AuthService.HasPermissionAsync("veterinarios.eliminar");
    }

    private async Task LoadVeterinarios()
    {
        try
        {
            loading = true;
            veterinarios = (await VeterinarioClient.GetAllAsync())?.ToList();
            successMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar veterinarios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (veterinarioModal != null)
        {
            await veterinarioModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(VeterinarioDTO vet)
    {
        if (veterinarioModal != null)
        {
            await veterinarioModal.ShowEditModal(vet);
        }
    }

    private async Task Eliminar(VeterinarioDTO vet)
    {
        await VeterinarioClient.DeleteAsync(vet.IdVeterinario);
        await LoadVeterinarios();
    }

    private void Cancel()
    {
        isEditing = false;
    }

    private async Task ConfirmDelete(VeterinarioDTO vet)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el cliente {vet.NombreVeterinario} {vet.Apellido} ({vet.Mail})?");

        if (confirm)
        {
            await DeleteVeterinario(vet.IdVeterinario);
        }
    }

    private async Task DeleteVeterinario(int id)
    {
        try
        {
            await VeterinarioClient.DeleteAsync(id);
            successMessage = "Veterinario eliminado exitosamente.";
            await LoadVeterinarios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar veterinario: {ex.Message}";
        }
    }
}