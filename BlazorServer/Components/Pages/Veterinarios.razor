@page "/veterinarios"

@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject VeterinarioClient VeterinarioClient

<PageTitle>Gestión de Veterinarios</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Veterinarios</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (canRead)
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Id</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Teléfono</th>
                                <th>Mail</th>
                                <th>DNI</th>
                                <th>Dirección</th>
                                <th>Matrícula</th>
                                <th>Especialidad</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (veterinarios != null && veterinarios.Any())
                            {
                                @foreach (var vet in veterinarios)
                                {
                                    <tr>
                                        <td class="align-middle">@vet.IdVeterinario</td>
                                        <td class="align-middle">@vet.NombreVeterinario</td>
                                        <td class="align-middle">@vet.Apellido</td>
                                        <td class="align-middle">@vet.Telefono</td>
                                        <td class="align-middle">@vet.Mail</td>
                                        <td class="align-middle">@vet.Dni</td>
                                        <td class="align-middle">@vet.Direccion</td>
                                        <td class="align-middle">@vet.Matricula</td>
                                        <td class="align-middle">@vet.Especialidad</td>
                                        <td class="align-middle text-nowrap">
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(vet)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(vet)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4 text-muted">No hay veterinarios registrados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<VeterinarioModal @ref="veterinarioModal" OnVeterinarioChanged="LoadVeterinarios" />

@code {
    private List<VeterinarioDTO>? veterinarios;
    private bool loading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private VeterinarioModal veterinarioModal = default!;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Se verifica si el usuario tiene el rol Administrador (opcional, por doble seguridad)
        var rol = await AuthService.GetRolAsync();
        if (rol?.Trim().ToUpper() != "ADMINISTRADOR")
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadPermissions();

        if (canRead)
        {
            await LoadVeterinarios();
        }
        else
        {
            loading = false;
            errorMessage = "No tiene permisos para ver veterinarios.";
        }
    }

    private async Task LoadPermissions()
    {
        canRead = await AuthService.HasPermissionAsync("veterinarios.leer");
        canAdd = await AuthService.HasPermissionAsync("veterinarios.agregar");
        canUpdate = await AuthService.HasPermissionAsync("veterinarios.actualizar");
        canDelete = await AuthService.HasPermissionAsync("veterinarios.eliminar");
    }

    private async Task LoadVeterinarios()
    {
        try
        {
            loading = true;
            errorMessage = string.Empty;
            veterinarios = (await VeterinarioClient.GetAllAsync())?.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar veterinarios: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenAddModal()
    {
        if (veterinarioModal != null)
        {
            await veterinarioModal.ShowAddModal();
        }
    }

    private async Task OpenEditModal(VeterinarioDTO vet)
    {
        if (veterinarioModal != null)
        {
            await veterinarioModal.ShowEditModal(vet);
        }
    }

    private async Task ConfirmDelete(VeterinarioDTO vet)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Está seguro que desea eliminar el veterinario {vet.NombreVeterinario} {vet.Apellido} ({vet.Mail})?");

        if (confirm)
        {
            await DeleteVeterinario(vet.IdVeterinario);
        }
    }

    private async Task DeleteVeterinario(int id)
    {
        try
        {
            await VeterinarioClient.DeleteAsync(id);
            successMessage = "Veterinario eliminado exitosamente.";
            await LoadVeterinarios();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar veterinario: {ex.Message}";
        }
    }
}