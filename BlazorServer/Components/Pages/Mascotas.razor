@page "/duenio/mascotas"
@rendermode InteractiveServer

@using DTOs
@using API.Clients
@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject MascotaClient MascotaClient

<PageTitle>Mis Mascotas</PageTitle>

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Mis Mascotas</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
                </div>
            }

            @if (canAdd)
            {
                <div class="mb-3">
                    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">
                        <i class="fas fa-plus"></i> Nueva Mascota
                    </button>
                </div>
            }

            @if (loading)
            {
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (canRead)
            {
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Especie</th>
                                <th>Raza</th>
                                <th>Sexo</th>
                                <th>Castrado</th>
                                <th>Fecha Nacimiento</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (mascotas != null && mascotas.Any())
                            {
                                @foreach (var mascota in mascotas)
                                {
                                    <tr>
                                        <td class="align-middle fw-bold">@mascota.NombreMascota</td>
                                        <td class="align-middle">@mascota.Especie</td>
                                        <td class="align-middle">@mascota.Raza</td>
                                        <td class="align-middle">@(mascota.Sexo == 'M' ? "Macho" : "Hembra")</td>
                                        <td class="align-middle">
                                            @if (mascota.Castrado)
                                            {
                                                <span class="badge bg-success">Sí</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-secondary">No</span>
                                            }
                                        </td>
                                        <td class="align-middle">@mascota.FechaNac.ToString("dd/MM/yyyy")</td>
                                        <td class="align-middle text-nowrap">
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(mascota)">
                                                    <i class="fas fa-edit"></i> Editar
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(mascota)">
                                                    <i class="fas fa-trash"></i> Eliminar
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center py-4 text-muted">Aún no tenés mascotas registradas.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<MascotaModal @ref="mascotaModal" OnMascotaChanged="LoadMascotas" />

@code {
    private List<MascotaDTO>? mascotas;
    private bool loading = true;
    private int? currentUserId;
    private MascotaModal mascotaModal = default!;

    private string? errorMessage;

    private bool canRead = false;
    private bool canAdd = false;
    private bool canUpdate = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!isAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        currentUserId = await AuthService.GetPersonaIdAsync();

        canRead = true;
        canAdd = true;
        canUpdate = true;
        canDelete = true;

        await LoadMascotas();
    }

    private async Task LoadMascotas()
    {
        try
        {
            loading = true;
            if (currentUserId.HasValue)
            {
                mascotas = await MascotaClient.GetAllByDuenioAsync(currentUserId.Value);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenAddModal()
    {
        if (mascotaModal != null) await mascotaModal.ShowAddModal();
    }

    private async Task OpenEditModal(MascotaDTO mascota)
    {
        if (mascotaModal != null) await mascotaModal.ShowEditModal(mascota);
    }

    private async Task ConfirmDelete(MascotaDTO mascota)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"¿Estás seguro que querés eliminar a {mascota.NombreMascota}?");

        if (confirm)
        {
            await DeleteMascota(mascota.IdMascota);
        }
    }

    private async Task DeleteMascota(int id)
    {
        try
        {
            errorMessage = null;
            loading = true;
            await MascotaClient.DeleteAsync(id);

            await LoadMascotas();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message; ;
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
